# --- Database -------------------------------------------------------------
# Matches docker-compose.yml. The container's 5432 is published on host 5434
# because 5432 is usually taken by a locally installed PostgreSQL and 5433 by
# Docker's WSL relay. Override there with POSTGRES_HOST_PORT and mirror it here.
# Swap for any Postgres connection string.
DATABASE_URL="postgresql://miniledger:miniledger@localhost:5434/miniledger?schema=public"
TEST_DATABASE_URL="postgresql://miniledger:miniledger@localhost:5434/miniledger_test?schema=public"

# --- Auth -----------------------------------------------------------------
JWT_SECRET="change-me-in-real-life-min-32-chars-long"
JWT_EXPIRES_IN="7d"

# --- OTP ------------------------------------------------------------------
# Seconds a generated OTP stays valid.
OTP_TTL_SECONDS=300
# Wrong-code attempts allowed before the OTP is burned.
OTP_MAX_ATTEMPTS=5
# When true, /auth/request-otp also returns the code in the response body.
# Handy for demos and tests. NEVER enable in production.
DEV_RETURN_OTP=true

# --- Server ---------------------------------------------------------------
PORT=4000
NODE_ENV=development
CORS_ORIGIN="*"

# --- Uploads --------------------------------------------------------------
UPLOAD_DIR="uploads"
MAX_UPLOAD_BYTES=5242880
